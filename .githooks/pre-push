#!/bin/sh
# Second gate: nothing under corpus/ (except corpus/README.md) may be pushed (CLAUDE.md §3).
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    pnpm --silent check:corpus --tracked || status=1   # new branch: check everything tracked
  else
    pnpm --silent check:corpus --range "$remote_sha..$local_sha" || status=1
  fi
done
exit $status
