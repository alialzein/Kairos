{
  "openapi": "3.1.0",
  "info": {
    "title": "twin-brain",
    "version": "0.0.1"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/owner/ping": {
      "get": {
        "summary": "Owner Ping",
        "operationId": "owner_ping_owner_ping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Owner Ping Owner Ping Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/turn": {
      "post": {
        "summary": "Turn",
        "operationId": "turn_turn_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/TurnStart"
                      },
                      {
                        "$ref": "#/components/schemas/TurnDelta"
                      },
                      {
                        "$ref": "#/components/schemas/TurnEnd"
                      },
                      {
                        "$ref": "#/components/schemas/AvatarStateEvent"
                      },
                      {
                        "$ref": "#/components/schemas/AvatarEnergy"
                      },
                      {
                        "$ref": "#/components/schemas/MemoryCandidateEvent"
                      },
                      {
                        "$ref": "#/components/schemas/ErrorEvent"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "type",
                      "mapping": {
                        "turn.start": "#/components/schemas/TurnStart",
                        "turn.delta": "#/components/schemas/TurnDelta",
                        "turn.end": "#/components/schemas/TurnEnd",
                        "avatar.state": "#/components/schemas/AvatarStateEvent",
                        "avatar.energy": "#/components/schemas/AvatarEnergy",
                        "memory.candidate": "#/components/schemas/MemoryCandidateEvent",
                        "error": "#/components/schemas/ErrorEvent"
                      }
                    }
                  },
                  "type": "array",
                  "title": "Response Turn Turn Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AvatarEnergy": {
        "properties": {
          "type": {
            "type": "string",
            "const": "avatar.energy",
            "title": "Type"
          },
          "value": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "title": "AvatarEnergy"
      },
      "AvatarState": {
        "type": "string",
        "enum": [
          "DORMANT",
          "IDLE",
          "WAKING",
          "LISTENING",
          "THINKING",
          "SPEAKING",
          "OFFLINE"
        ],
        "title": "AvatarState"
      },
      "AvatarStateEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "avatar.state",
            "title": "Type"
          },
          "state": {
            "$ref": "#/components/schemas/AvatarState"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "state"
        ],
        "title": "AvatarStateEvent"
      },
      "ErrorEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "error",
            "title": "Type"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "code",
          "message"
        ],
        "title": "ErrorEvent"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryCandidateEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "memory.candidate",
            "title": "Type"
          },
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "candidate_id",
          "kind",
          "summary"
        ],
        "title": "MemoryCandidateEvent"
      },
      "TurnDelta": {
        "properties": {
          "type": {
            "type": "string",
            "const": "turn.delta",
            "title": "Type"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid",
            "title": "Turn Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "turn_id",
          "text"
        ],
        "title": "TurnDelta"
      },
      "TurnEnd": {
        "properties": {
          "type": {
            "type": "string",
            "const": "turn.end",
            "title": "Type"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid",
            "title": "Turn Id"
          },
          "style_applied": {
            "type": "boolean",
            "title": "Style Applied"
          },
          "latency_ms": {
            "additionalProperties": {
              "type": "number",
              "minimum": 0.0
            },
            "type": "object",
            "title": "Latency Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "turn_id",
          "style_applied",
          "latency_ms"
        ],
        "title": "TurnEnd"
      },
      "TurnRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text"
          },
          "channel": {
            "type": "string",
            "enum": [
              "web",
              "voice",
              "mobile",
              "guest"
            ],
            "title": "Channel"
          },
          "register": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "casual",
                  "professional"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Register"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "channel",
          "session_id"
        ],
        "title": "TurnRequest"
      },
      "TurnStart": {
        "properties": {
          "type": {
            "type": "string",
            "const": "turn.start",
            "title": "Type"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid",
            "title": "Turn Id"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "turn_id",
          "session_id"
        ],
        "title": "TurnStart"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
